{
  "base": {
    "project": "Open Food Facts autotests",
    "environment": "${EXECUTION_ENVIRONMENT}",
    "allureFolder": "allure-report",
    "logo": "https://allurereports.com/images/allure-logo.png",
    "reportLink": "${BUILD_URL}allure",
    "language": "ru",
    "enableChart": true,
    "comment": "Запуск автотестов Open Food Facts в Jenkins завершен",
    "durationFormat": "HH:mm:ss.SSS",
    "enableSuitesPublishing": false
  },
  "telegram": {
    "token": "${TELEGRAM_BOT_TOKEN}",
    "chat": "${TELEGRAM_CHAT_ID}",
    "replyTo": ""
  }
}
